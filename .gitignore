.DS_Store
node_modules/
.env
*.log
.vscode/
.idea/
Thumbs.db
__pycache__/
*.pyc
extras/
.playwright-mcp/

# Backup files (prevent production backups)
*.backup
*.bak
*.tmp
*.swp
*.swo
*~
.DS_Store?

# Test results
test-results/
.test-results/
playwright-report/

# Audit reports (generated)
.audit-*/
.review-*/

# App sources — keep source committed, ignore build intermediates.
# docs/ at repo root IS committed: it is the artefact GitHub Pages serves.
# v2-src/public/data/ is a build-time copy of data/, regenerated by sync-data.
v2-src/.next/
v2-src/.dist/
v2-src/node_modules/
v2-src/public/data/

# Review harness: keep the harness itself, drop per-run output and the
# ad-hoc probe scripts reviewers write.
.review/*
!.review/harness.mjs
